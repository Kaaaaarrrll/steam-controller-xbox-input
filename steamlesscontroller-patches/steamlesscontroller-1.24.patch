+// ---------------------------------------------------------------------------
+// Audio haptics - an addition to upstream. Its settings live in the registry,
+// where AudioHaptics reads them; the page writes them on every change and the
+// engine reloads, so the tab has no Apply step.
+// ---------------------------------------------------------------------------
+
+namespace {
+
+void WriteHapticSetting(const wchar_t* name, DWORD value) {
+    HKEY key = nullptr;
+    if (RegCreateKeyExW(HKEY_CURRENT_USER, L"Software\\SteamlessController", 0, nullptr, 0,
+                        KEY_SET_VALUE, nullptr, &key, nullptr) != ERROR_SUCCESS) {
+        return;
+    }
+    RegSetValueExW(key, name, 0, REG_DWORD, reinterpret_cast<const BYTE*>(&value), sizeof(value));
+    RegCloseKey(key);
+}
+
+DWORD ReadHapticSetting(const wchar_t* name, DWORD fallback) {
+    DWORD data = 0;
+    DWORD cb = sizeof(data);
+    if (RegGetValueW(HKEY_CURRENT_USER, L"Software\\SteamlessController", name, RRF_RT_REG_DWORD,
+                     nullptr, &data, &cb) != ERROR_SUCCESS) {
+        return fallback;
+    }
+    return data;
+}
+
+// Must match AudioHaptics' own defaults, or the tab would show values the
+// engine is not using. Haptics are off by default: they replace the game's
+// own rumble, so they are opt-in.
+constexpr DWORD kHapticBandDefaults[AudioHaptics::kBandCount] = {400, 160, 0, 0, 0, 0};
+
+void ApplyHapticsMessage(const std::string& msg) {
+    auto num = [&](const char* key, DWORD fallback) -> DWORD {
+        const std::string v = JsonStr(msg, key);
+        return v.empty() ? fallback : static_cast<DWORD>(std::strtoul(v.c_str(), nullptr, 10));
+    };
+    WriteHapticSetting(L"HapticAudioMode",    num("on", 0));
+    WriteHapticSetting(L"HapticAudioGain",    num("gain", 854));
+    WriteHapticSetting(L"HapticAudioDelayMs", num("delay", 68));
+    WriteHapticSetting(L"HapticAudioLatency", num("buf", 64));
+    WriteHapticSetting(L"HapticAudioRate",    num("rate", 4000));
+    WriteHapticSetting(L"HapticRumbleGate",   num("gate", 1));
+    for (int band = 0; band < AudioHaptics::kBandCount; ++band) {
+        char key[8];
+        std::snprintf(key, sizeof(key), "eq%d", band);
+        wchar_t name[32];
+        _snwprintf_s(name, _TRUNCATE, L"HapticEqBand%d", band);
+        WriteHapticSetting(name, num(key, kHapticBandDefaults[band]));
+    }
+    AudioHaptics::Instance().Reload();
+}
+
+std::wstring HapticsStateJson() {
+    std::wstring json =
+        L"{\"type\":\"hapticsState\""
+        L",\"on\":\""    + std::to_wstring(ReadHapticSetting(L"HapticAudioMode", 0))     + L"\""
+        L",\"gain\":\""  + std::to_wstring(ReadHapticSetting(L"HapticAudioGain", 854))   + L"\""
+        L",\"delay\":\"" + std::to_wstring(ReadHapticSetting(L"HapticAudioDelayMs", 68)) + L"\""
+        L",\"buf\":\""   + std::to_wstring(ReadHapticSetting(L"HapticAudioLatency", 64)) + L"\""
+        L",\"rate\":\""  + std::to_wstring(ReadHapticSetting(L"HapticAudioRate", 4000))  + L"\""
+        L",\"gate\":\""  + std::to_wstring(ReadHapticSetting(L"HapticRumbleGate", 1))    + L"\"";
+    for (int band = 0; band < AudioHaptics::kBandCount; ++band) {
+        wchar_t name[32];
+        _snwprintf_s(name, _TRUNCATE, L"HapticEqBand%d", band);
+        json += L",\"eq" + std::to_wstring(band) + L"\":\""
+              + std::to_wstring(ReadHapticSetting(name, kHapticBandDefaults[band])) + L"\"";
+    }
+    return json + L"}";
+}
+
