+            // Four bits in the report are undecoded — buf[2] 0x10 and buf[5]
+            // 0x08/0x40/0x80 — and the button between the trackpads appears
+            // nowhere in the decoded map, so it is almost certainly one of
+            // them. Nothing reads those bits, which is why that button
+            // currently does nothing at all. Log a transition so it can be
+            // identified from the event log rather than guessed at: press the
+            // button, read the line.
+            //
+            // Free in the steady state: it writes only on a change, and by
+            // definition these bits do not move during ordinary play.
+            if (n > 5) {
+                // 0x10 is no longer unknown - it is the Quick Access button,
+                // named above. Three bits in the flags byte still are.
+                constexpr uint8_t kNamed2 = 0xFF;  // A B X Y, Quick Access, RS, Menu, R4
+                constexpr uint8_t kNamed5 = 0x37;  // LS touch, both pads, both grips
+                const uint8_t moved2 = static_cast<uint8_t>((buf[2] ^ prevBuf[2]) & ~kNamed2);
+                const uint8_t moved5 = static_cast<uint8_t>((buf[5] ^ prevBuf[5]) & ~kNamed5);
+                if (moved2 != 0 || moved5 != 0) {
+                    EventLog::Write("UNKNOWNBIT: buf[2]=0x%02X moved 0x%02X | "
+                                    "buf[5]=0x%02X moved 0x%02X",
+                                    buf[2], moved2, buf[5], moved5);
+                }
+            }
+
+            // The "..." button between the pads toggles the Windows touch
+            // keyboard: press to show, press again to hide. Toggle() is already
+            // a toggle and already hands the cross-process call to a worker, so
+            // this stays off the report loop.
+            //
+            // Hard-wired rather than a rebindable row on purpose, for now. A
+            // binding is plumbed through seven files, two of which are being
+            // deleted in the strip-down; this becomes a proper row on the far
+            // side of that, and the button does something useful in the
+            // meantime instead of nothing.
+            //
+            // Edge-detected on the press, so holding it does not flap the
+            // keyboard open and shut at report rate.
+            if (n > 2) {
+                const bool qaNow  = (buf[2]     & SteamController::BTN_QUICK_ACCESS) != 0;
+                const bool qaWas  = (prevBuf[2] & SteamController::BTN_QUICK_ACCESS) != 0;
+                if (qaNow && !qaWas) {
+                    EventLog::Write("QUICKACCESS: toggling the touch keyboard");
+                    TouchKeyboard::Toggle();
+                }
+            }
+
