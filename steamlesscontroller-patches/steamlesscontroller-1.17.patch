+// ---- Audio haptics tab ----
+// The page owns no state of its own here: every change posts the whole set and
+// the host applies it live, which is why there is no Apply button on this tab.
+var HAP_HZ = ['30','60','120','240','480','960'];
+var hapReady = false;
+
+function hapSwitch(toHaptics){
+  // A row left listening keeps the host capturing the controller, and its only
+  // sign is a highlight on a row this tab is about to hide - so the next button
+  // press would rebind something invisibly. Same for the game picker: it would
+  // still be open, mid-search, on the way back.
+  if (toHaptics) { cancelListening(); closeCombo(); }
+  document.getElementById('tab-controls').style.display = toHaptics ? 'none' : '';
+  document.getElementById('tab-haptics').style.display  = toHaptics ? '' : 'none';
+  // Apply and Reset commit a controller profile, which the haptics tab has no
+  // concept of - its changes are already live. Leaving the bar visible there
+  // implied there was something pending to save.
+  document.getElementById('footer').style.display = toHaptics ? 'none' : '';
+  document.getElementById('tab-btn-controls').className = toHaptics ? 'tab' : 'tab on';
+  document.getElementById('tab-btn-haptics').className  = toHaptics ? 'tab on' : 'tab';
+}
+document.getElementById('tab-btn-controls').onclick = function(){ hapSwitch(false); };
+document.getElementById('tab-btn-haptics').onclick  = function(){ hapSwitch(true); };
+
+(function buildEq(){
+  var eq = document.getElementById('eq');
+  var html = '';
+  for (var i = 0; i < HAP_HZ.length; i++) {
+    html += '<div class="eq-band">'
+          + '<input type="range" id="eq-' + i + '" min="0" max="400" orient="vertical">'
+          + '<div class="eq-hz">' + HAP_HZ[i] + '</div>'
+          + '<div class="eq-val" id="eq-v-' + i + '"></div>'
+          + '</div>';
+  }
+  eq.innerHTML = html;
+})();
+
+function hapLabels(){
+  document.getElementById('hap-gain-v').textContent  = document.getElementById('hap-gain').value + '%';
+  document.getElementById('hap-delay-v').textContent = document.getElementById('hap-delay').value + ' ms';
+  document.getElementById('hap-buf-v').textContent   = document.getElementById('hap-buf').value + ' packets';
+  for (var i = 0; i < HAP_HZ.length; i++) {
